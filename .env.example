# Port des lokalen Servers (nur 127.0.0.1)
KL_PORT=8810
# Erlaubte Origin für CORS (Vite-Dev-Server)
KL_ORIGIN=http://127.0.0.1:5180
# Themen, die beim Build ausgelassen werden (Komma-getrennt, z. B. für öffentliches Hosting)
KL_AUSSCHLIESSEN=
# Pfad zum claude-Binary für den Video-Tutor (Standard: claude aus dem PATH)
KL_CLAUDE_BIN=claude
